# Copiez ce fichier en ".env" à la racine du projet et remplissez les valeurs.
# Ne commitez jamais le fichier ".env" réel.

# --- Telegram ---
# Le même token que celui utilisé par main.py (BotFather)
TELEGRAM_BOT_TOKEN=

# Votre chat_id Telegram : devient automatiquement administrateur au /start
# (obtenez-le en envoyant /start au bot @userinfobot)
ADMIN_TELEGRAM_CHAT_ID=

# Nom d'utilisateur du bot sans @ (ex: CelluleTradeCashBot) -- utilisé pour
# rediriger vers la conversation après un paiement Stripe
TELEGRAM_BOT_USERNAME=

# --- Base de données ---
# En local : sqlite:///celluletrade_cash_saas.db (par défaut, rien à faire)
# En production : postgresql://user:password@localhost:5432/celluletrade_cash_saas
# Avec docker-compose (self-host) : laissez la valeur par défaut ci-dessous,
# DATABASE_URL est recalculée automatiquement à partir de POSTGRES_PASSWORD
# (voir docker-compose.yml).
DATABASE_URL=sqlite:///celluletrade_cash_saas.db

# Mot de passe de la base Postgres utilisée par docker-compose (self-host).
# Laisser vide si vous n'utilisez pas Docker.
POSTGRES_PASSWORD=

# --- Chiffrement ---
# Générer une clé une seule fois avec :
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# --- Stripe (optionnel pour tester sans paiement) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_LIFETIME=
STRIPE_POLL_INTERVAL=300

# --- Divers ---
SUPPORT_CONTACT=@votre_pseudo_telegram

# --- Surveillance Binance / Rise (multi-clients) ---
# Websocket Alchemy (réseau Arbitrum) pour détecter les dépôts Rise
ALCHEMY_WS_URL=

# Notifie le dépôt le plus récent déjà existant lors de la 1ère connexion
# d'un client (true) ou ignore l'historique et ne notifie que les nouveaux
# dépôts à venir (false)
BINANCE_NOTIFY_FIRST_DEPOSIT=true

# Intervalle (secondes) entre deux vérifications REST de secours Binance
BINANCE_FALLBACK_INTERVAL=900

# Intervalle (secondes) entre deux scans de la base pour démarrer/arrêter
# les surveillances par client
MONITORING_POLL_INTERVAL=60
